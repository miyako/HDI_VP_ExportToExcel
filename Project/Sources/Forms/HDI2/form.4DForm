{
	"destination": "detailScreen",
	"windowSizingX": "fixed",
	"windowMinHeight": 540,
	"windowMaxHeight": 32000,
	"rightMargin": 20,
	"bottomMargin": 20,
	"menuBar": "Menu Bar #1",
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "A4",
		"paperWidth": "842pt",
		"paperHeight": "595pt"
	},
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 1097,
					"height": 784,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "_TabTitles",
					"dataSourceTypeHint": "arrayText",
					"action": "gotoPage",
					"events": [
						"onClick"
					]
				},
				"Line": {
					"type": "line",
					"top": 0,
					"left": 568,
					"height": 640,
					"visibility": "hidden",
					"sizingY": "grow",
					"stroke": "#800080",
					"strokeDashArray": "1 1"
				}
			}
		},
		{
			"objects": {
				"information": {
					"type": "input",
					"top": 119,
					"left": 51,
					"width": 1037,
					"height": 480,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "Infos[0].Description",
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none",
					"enterable": false,
					"styledText": true,
					"contextMenu": "none",
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					]
				}
			}
		},
		{
			"objects": {
				"ViewProArea": {
					"type": "view",
					"top": 88,
					"left": 28,
					"width": 1080,
					"height": 706,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSourceTypeHint": "object",
					"borderStyle": "none",
					"method": "ObjectMethods/ViewProArea.4dm",
					"userInterface": "toolbar",
					"withFormulaBar": true,
					"events": [
						"onVPReady"
					]
				},
				"exportxlsx": {
					"type": "button",
					"top": 54,
					"left": 942,
					"width": 166,
					"height": 28,
					"text": "Export xlsx file",
					"focusable": false,
					"method": "ObjectMethods/exportxlsx.4dm",
					"events": [
						"onClick"
					]
				},
				"importxlsx": {
					"type": "button",
					"top": 54,
					"left": 28,
					"width": 166,
					"height": 28,
					"text": "Import xlsx file",
					"focusable": false,
					"method": "ObjectMethods/importxlsx.4dm",
					"events": [
						"onClick"
					]
				},
				"Texte": {
					"type": "text",
					"top": 52,
					"left": 215,
					"width": 706,
					"height": 32,
					"textAlign": "center",
					"fontFamily": "Segoe UI",
					"fontSize": 24,
					"text": "Import / export in MS Excel format"
				}
			}
		}
	],
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {},
			"Guides": {
